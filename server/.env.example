PORT=5000
MONGODB_URI=mongodb://localhost:27017/vichar

# Exact origin of the frontend. Required — cookies are only sent cross-origin
# when CORS echoes a specific origin (a wildcard is rejected with credentials).
CORS_ORIGIN=http://localhost:5173

# Signing key for the auth JWT. Use a long random value; changing it
# invalidates every existing session.
JWT_SECRET=replace-me-with-a-long-random-string

# Set to "production" in deployment so the auth cookie is sent with
# Secure + SameSite=None (needed when the frontend is on another domain).
NODE_ENV=development

# Google Gemini API key powering the AI editor actions (/api/ai/grammar, /api/ai/format).
# Optional: leave it unset and those endpoints answer 503 while the rest of the
# app works normally. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override for the Gemini model. Defaults to gemini-3.6-flash.
# Note gemini-2.5-flash is closed to new API keys (404), and Gemini 3.x models
# reject `thinkingBudget` — the code uses `thinkingLevel`, which both accept.
GEMINI_MODEL=
